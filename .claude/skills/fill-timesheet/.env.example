# Jira and GitHub credentials for the fill-timesheet skill.
# Copy this file to .env (gitignored) and fill in the values. Never commit .env.
# Environment variables already set in the shell take precedence over this file.
# Every key below must exist (EXCLUDED_DATES may be empty) or the script crashes on start.

# Jira Basic Auth: your InfoTrack email + an Atlassian API token
# (Atlassian -> Account Settings -> Security -> API tokens -> Create).
JIRA_USERNAME=
JIRA_TOKEN=

# GitHub username whose commits are matched, and a personal access token with
# read access to the repos listed in scripts/timesheets.py.
GITHUB_AUTHOR=
GITHUB_TOKEN=

# Comma-separated YYYY-MM-DD dates of personal/sick leave to skip. Leave empty if none.
EXCLUDED_DATES=

# AU state code for public holidays (NSW, VIC, QLD, SA, WA, TAS, ACT, NT). Defaults to NSW.
STATE=NSW
